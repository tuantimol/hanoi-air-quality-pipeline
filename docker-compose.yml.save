services:
  postgres:
    image: postgres:16
    env_file: .env                      # đọc user/password/db từ file .env
    ports: ["5432:5432"]                # máy_bạn:container
    volumes:
      - pg_data:/var/lib/postgresql/data   # giữ dữ liệu khi container bị xóa

  # ---------- Data Lake (giống AWS S3) ----------
  minio:
    image: minio/minio
    command: server /data --console-address ":9001"
    env_file: .env
    ports:
      - "9000:9000"                     # cổng API (code Python dùng cổng này)
      - "9001:9001"                     # cổng giao diện web
    volumes:
      - minio_data:/data

  # ---------- Điều phối ----------
  airflow:
    build:
      context: .
      dockerfile: Dockerfile.airflow    # build từ Dockerfile ở bước 5
    command: standalone                 # chế độ all-in-one, phù hợp để học
    env_file: .env
    environment:
      AIRFLOW__CORE__LOAD_EXAMPLES: "false"   # tắt các DAG mẫu cho gọn
      PYTHONPATH: /opt/airflow/scripts        # để DAG import được scripts/
    ports: ["8080:8080"]
    volumes:
      - ./dags:/opt/airflow/dags              # sửa file trên máy, container thấy ngay
      - ./scripts:/opt/airflow/scripts
      - ./dbt_project:/opt/airflow/dbt_project
    depends_on: [postgres, minio]

  # ---------- Dashboard ----------
  metabase:
    image: metabase/metabase
    ports: ["3000:3000"]
    depends_on: [postgres]

volumes:
  pg_data:
  minio_data:
